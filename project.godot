; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Home Purrtect"
config/description="고양이 치즈가 집을 지키는 횡스크롤 액션 디펜스 (1막 개발 빌드)"
run/main_scene="res://scenes/start.tscn"
config/features=PackedStringArray("4.6", "Forward Plus")
config/icon="res://assets/ui/icon.png"

[autoload]

Layout="*res://scripts/layout.gd"
Touch="*res://scripts/touch.gd"
Fx="*res://scripts/fx.gd"
GameState="*res://scripts/game_state.gd"
RotateGate="*res://scripts/rotate_gate.gd"
Enemies="*res://scripts/enemy_data.gd"
Design="*res://scripts/style.gd"

[display]

window/size/viewport_width=1560
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation="sensor_landscape"

[gui]

theme/custom_font="res://assets/fonts/Pretendard-Regular.ttf"
theme/custom_theme="res://assets/ui/caldera_theme.tres"

