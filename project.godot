; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Home Purrtect"
config/description="고양이 치즈가 집을 지키는 횡스크롤 액션 디펜스 (1막 개발 빌드)"
config/features=PackedStringArray("4.6", "Forward Plus")
config/icon="res://icon.svg"
run/main_scene="res://scenes/main.tscn"

[autoload]

Layout="*res://scripts/layout.gd"
Touch="*res://scripts/touch.gd"

[display]

; 가로 모드(랜드스케이프) · 요즘 폰 비율 19.5:9 (아이폰 등) 기준 1560x720
window/size/viewport_width=1560
window/size/viewport_height=720
window/handheld/orientation=0
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

